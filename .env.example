# Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider Configuration
# Supported providers:
# - gemini (default if GEMINI_API_KEY is provided)
# - openai (default if OPENAI_API_KEY is provided)
# - groq / openrouter / custom openai-compatible (via AI_BASE_URL and AI_API_KEY)
# If no key is set, HireCheck AI falls back to its built-in intelligent NLP analyzer engine!

AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-2.0-flash

# Optional OpenAI / OpenAI-compatible endpoint settings:
# OPENAI_API_KEY=your_openai_key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Bot Configuration
MAX_RESUMES_PER_USER=5
MAX_FILE_SIZE_MB=15
LOG_LEVEL=INFO
